# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=medicare-super-secret-key-change-in-production
JWT_SECRET_KEY=medicare-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration (Defaults to local SQLite if not provided)
# For SQLite:
DATABASE_URL=sqlite:///medicare.db
# For PostgreSQL:
# DATABASE_URL=postgresql://medicare_user:password@localhost:5432/medicare

# CORS Configuration
CORS_ORIGINS=*

# Port
PORT=5000
HOST=127.0.0.1
